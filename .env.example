# 大模型金融分析项目根目录（阿里云服务器路径）
export FINANCE_PROJECT_ROOT=/opt/finance-analysis

# Qwen-VL API Key（截图解析）
export QWEN_API_KEY=sk-7f45108d8cd043c48306f860228d5479

# 大模型配置（调仓建议）— 通过 CloseAI 代理统一接入
# 文档：https://doc.closeai-asia.com/tutorial/library.html
export LLM_API_KEY=sk-your-closeai-key
# base_url 默认 https://api.openai-proxy.org/v1，如需切换到其他代理可覆盖
# export LLM_BASE_URL=https://api.openai-proxy.org/v1
# 模型名称，默认 gemini-3.1-pro-preview；可换成 deepseek-reasoner、claude-sonnet-4-20250514 等
# export LLM_MODEL=gemini-3.1-pro-preview

# 旧版 DeepSeek Key（兼容保留，LLM_API_KEY 优先）
export DEEPSEEK_API_KEY=sk-c75ee0f98c8c410ea0e5005f3b3bc5fa

# 服务端口（默认 8001，避免与 finance-analysis 的 8000 冲突）
export PORT=8001

# 飞书群机器人 Webhook
export FEISHU_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/1b0f0064-48cb-43b5-9bb1-8b30188a3e8c
